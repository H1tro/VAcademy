# Supabase project configuration (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server API key; never prefix this with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Legacy service_role key is also supported as SUPABASE_SERVICE_ROLE_KEY

# Supabase Authentication UUIDs of trusted administrators (comma separated)
ADMIN_UIDS=

# Server-side AI provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Telegram notifications for tickets saved in Supabase
TELEGRAM_BOT_TOKEN=

# Service emails and email-confirmation redirects
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:9002
RESEND_FROM_EMAIL=
# Required for deletion emails: use an address on a domain verified in Resend.
# onboarding@resend.dev only sends test emails to the Resend account owner.
