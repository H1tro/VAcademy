# Supabase project configuration (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Firebase web app configuration (Firebase Console → project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account; never use NEXT_PUBLIC_ for these values
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Authentication UIDs of trusted site administrators (comma separated).
# Never expose this value through NEXT_PUBLIC_ or editable profile fields.
ADMIN_UIDS=

# Server-side AI provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Telegram notifications for tickets saved in Firestore
TELEGRAM_BOT_TOKEN=
